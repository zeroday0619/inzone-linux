# Vendor downloads, extracted assets and local backups.
/downloads/
/assets/
/backups/

# Raw analysis stays local. Only reviewed summary reports are published.
/analysis/*
!/analysis/README.md
!/analysis/impulse-results.json
!/analysis/pipewire-sfx-results.json
!/analysis/live-profile-results.json
!/analysis/live-automation-results.json
!/analysis/device-write-verification.json
!/analysis/profile-switch-results.json
!/analysis/install-results.json
!/analysis/tui-results.json

# Download provenance is public; raw device captures are local.
/evidence/*
!/evidence/installer.json

# Downloaded decompiler and its package cache.
/tools/ilspycmd
/tools/.store/
.dotnet/
.nuget/

# Binary/reversing artifacts, even if copied outside their usual directories.
*.exe
*.dll
*.dll[0-9]*
*.msi
*.cab
*.ole
*.bin
*.hki
*.ba
*.decoded
*.asm
*.decompiled.cs
*.strings-*.txt
*.pe.txt
*.wav
*.f32

# Swift Package Manager state and generated Swift artifacts.
.build/
.swiftpm/
*.swiftmodule
*.swiftdoc
*.swiftsourceinfo
*.abi.json
*.dia
*.dSYM/
*.profraw
*.profdata

# Native build and coverage artifacts.
*.so
*.so.*
*.o
*.a
*.d
*.gcda
*.gcno

# Editor files and local configuration.
*.log
*.tmp
*.swp
.DS_Store
.env
.env.*
!.env.example
